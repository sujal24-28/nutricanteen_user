# Web: use /api/v1 when frontend and backend share the same origin (Vite proxy).
VITE_API_BASE_URL=/api/v1

# Native Android/iOS: use an absolute URL reachable from the phone/device.
# IMPORTANT: replace the IP with the current IPv4 address of the PC running Node.
# The phone and PC must be on the same Wi-Fi/LAN for a local HTTP address.
VITE_NATIVE_API_BASE_URL=http://192.168.0.122:5000/api/v1
