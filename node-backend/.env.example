# ============================================================
# NutriCanteen Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nutricanteen_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---- JWT Secrets ----
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- MSG91 OTP Service ----
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=NTRCNT
MSG91_ROUTE=4
# MSG91 Template IDs (create templates in MSG91 dashboard)
MSG91_LOGIN_TEMPLATE_ID=your_login_template_id
MSG91_TOPUP_TEMPLATE_ID=your_topup_template_id

# ---- OTP Settings ----
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ---- Wallet ----
WALLET_MAX_TOPUP=5000
WALLET_MIN_TOPUP=10

# ---- File Uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:19006

# ---- Rate Limiting ----
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
